---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export type MetaEntry =
    | { content: string; name: string }
    | { content: string; property: string };

export interface Props {
    title?: string;
    description?: string;
    meta?: MetaEntry[];
}

const {
    title = "init",
    description = "The systems development group at the IT Chapter @ KTH.",
    meta = [],
} = Astro.props;
const pageTitle = title === "init" ? "init" : `${title} | init`;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#000000" />
        
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="init" />
        <meta name="twitter:card" content="summary" />
        
        {meta.map((m) => "property" in m 
            ? ( <meta property={m.property} content={m.content} /> ) 
            : ( <meta name={m.name} content={m.content} /> )
        )}

        <ClientRouter />
    </head>
    <body>
        <div class="min-h-dvh w-full flex items-center flex-col">
            <slot />
        </div>
    </body>
</html>
