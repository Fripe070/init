---
import AboutLogo from "../assets/commit/about.svg";
import ArduinoPicture from "../assets/commit/arduino.webp";
import CommitLogo from "../assets/commit/commit.svg";
import FreestyleLogo from "../assets/commit/freestyle.svg";
import MachineLogo from "../assets/commit/machine.svg";
import TracksLogo from "../assets/commit/tracks.svg";
import WebdevLogo from "../assets/commit/webdev.svg";
import FaqSection from "../components/commit/faq-section.astro";
import ScheduleSection from "../components/commit/schedule.astro";
import Track from "../components/commit/track.astro";
import Layout from "../layouts/layout.astro";
import "../styles/global.css";
---

<Layout>
    <section class="space-y-4">
        <CommitLogo class="max-w-full h-auto" />
        <h2 class="text-center text-xl font-bold mb-20">19.9 - 20.9, 2026</h2>

        <AboutLogo class="w-auto max-h-7 flex mx-auto" />
        <p>
            <b>commit</b> is a weekend-long hackathon for chapter members hosted by us at
            <b>init</b>. Over the course of <b>commit</b>, you'll learn coding skills
            from KTH students, form a team, and work on a cool computer science
            project. <b>commit</b> is open to all skill levels, first time coders and expert
            hackers are all welcome.
        </p>
        <div>
            <img
                src={ArduinoPicture.src}
                alt="An arduino UNO R4 board"
                class="w-auto max-h-100 mx-auto"
            />
            <h3 class="text-center text-xl font-bold">Win an Arduino UNO!</h3>
        </div>

        <TracksLogo class="w-auto max-h-7 flex mb-4 mx-auto mt-20" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center justify-center">
            <Track 
                id="webdev" 
                title="Web Development" 
                description="Building responsive, accessible, and high-performance web applications."
            >
                <WebdevLogo class="w-full h-auto" />
            </Track>
            <Track
                id="machine"
                title="Machine Learning"
                description="Train intelligent systems, analyze data, and build predictive models."
            >
                <MachineLogo class="w-full h-auto" />
            </Track>
            <div class="md:col-span-2 md:justify-self-center md:w-[calc(50%-0.5rem)]">
                <Track
                    id="freestyle"
                    title="Freestyle"
                    description="For hackers who already have their own idea and want to build whatever they like."
                >
                    <FreestyleLogo class="w-full h-auto" />
                </Track>
            </div>
        </div>

        <ScheduleSection />

        <FaqSection />
    </section>
</Layout>
