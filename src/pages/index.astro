---
import Button from "../components/button.astro";
import Layout from "../layouts/StandardLayout.astro";
import "../styles/global.css";
---

<Layout>
    <section class="space-y-4 text-pretty">
        <p>
            We are <b>init</b>, the systems development group at the{" "}
            <a href="https://kth.it" class="whitespace-nowrap hover:underline underline-offset-4" >
                IT Chapter @ KTH
            </a>.
        </p>
        <p class="mb-8">
            We develop and maintain a number of systems that make life easier
            for the IT Chapter.
        </p>
        <div class="[&_button]:w-full md:[&_button]:w-fit flex flex-col md:flex-row gap-4">
            <a transition:name="join" href="/join">
                <Button link>Join</Button>
            </a>
            <a transition:name="contact" href="/contact">
                <Button variant="secondary" link>Contact</Button>
            </a>
            <a transition:name="documents" href="/documents">
                <Button variant="secondary" link>Documents</Button>
            </a>
        </div>
    </section>
</Layout>
