---
import FeedIcon from "../assets/feed.svg";
import { feeds } from "../feeds";
import typstDocuments, { getDocumentUrl, type DocumentEntry } from "../documents";

const documents = [
  {
    title: "Protocols",
    feed: feeds.protocols.path,
    docs: typstDocuments.protocols,
  },
  {
    title: "Reports",
    feed: feeds.reports.path,
    docs: typstDocuments.reports,
  },
  {
    title: "Statutes",
    docs: typstDocuments.statutes,
  },
] satisfies {
  title: string;
  feed?: string;
  docs: DocumentEntry[];
}[];

interface Props {
  currentDocPath?: string;
}
const { currentDocPath } = Astro.props as Props;
---

<div transition:name="documents-list" class="w-fit">
  {documents.map(({ title, docs, feed }) => (
    <div class="not-last:mb-4">
      <h2 class="flex items-center gap-2 text-lg font-bold">
        {title}
        {feed && (
          <a
            href={feed}
            title={`${title} RSS feed`}
            aria-label={`${title} RSS feed`}
            class="text-muted hover:text-primary transition-colors"
          >
            <FeedIcon class="size-3.5" />
          </a>
        )}
      </h2>
      <ul>
        {docs
          .toSorted((a, b) => a.path.localeCompare(b.path))
          .map((doc) => (
            <li>
              <a
                class={`block w-fit underline underline-offset-4 ${currentDocPath === doc.path ? "opacity-60" : "hover:opacity-80"}`}
                href={getDocumentUrl(doc)}
              >
                {doc.name}
              </a>
            </li>
          ))}
      </ul>
    </div>
  ))}
  <a
    href={feeds.all.path}
    class="mt-4 flex w-fit items-center gap-2 text-sm font-bold text-muted hover:text-primary transition-colors"
  >
    <FeedIcon class="size-3" />
    All documents
  </a>
</div>
